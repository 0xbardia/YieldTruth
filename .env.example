# Copy to .env for local runs. Do not commit .env.
# Never put a user wallet private key here. Contract writes are signed in the browser.

NODE_ENV=development
APP_URL=http://127.0.0.1:8080
API_PORT=8080
API_HOST=0.0.0.0
LOG_LEVEL=info

# Leave unset in this workspace to use embedded Postgres.
# DATABASE_URL=

GENLAYER_NETWORK=studionet
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999
GENLAYER_CONTRACT_ADDRESS=

VITE_APP_URL=http://127.0.0.1:8080
VITE_API_URL=
VITE_GENLAYER_NETWORK=studionet
VITE_GENLAYER_RPC_URL=https://studio.genlayer.com/api
VITE_GENLAYER_CHAIN_ID=61999
VITE_YIELDTRUTH_CONTRACT_ADDRESS=

# Public WalletConnect Cloud project id. Not a secret, but do not invent one.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional comma-separated extra browser origins for the read API.
CORS_ORIGINS=
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
